# Admin console agent settings.
#
# Precedence (highest wins):
#   real environment variables > admin-console/.env > repo-root .env > built-in defaults
# Values saved in the Settings page live in admin-console/server/data/settings.json
# (gitignored) and win over .env files, so this file is the initial/headless source.
# Copy to admin-console/.env and adjust. See also the repo-root .env.example.

# --- Bind address -----------------------------------------------------------------
# Keep 127.0.0.1 so the console is reachable only from this machine.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4300

# --- Backend endpoints (host-reachable) -------------------------------------------
# When ADMIN_DATABASE_URL is unset the agent builds it from the POSTGRES_* block
# below (the same keys the repo-root .env uses).
ADMIN_KRATOS_ADMIN_URL=http://127.0.0.1:4434
ADMIN_KRATOS_PUBLIC_URL=http://127.0.0.1:4433
ADMIN_INGESTION_URL=http://127.0.0.1:8080

# Source values shared with the repo-root .env. Usually set once at the repo root
# and inherited; listed here for reference.
# POSTGRES_USER=<postgres_user>
# POSTGRES_PASSWORD=<postgres_password>
# POSTGRES_DB=<postgres_db>
# The compose Kratos URLs are container-only; the host reaches Kratos through the
# ADMIN_* URLs above (or a tunnel):
# KRATOS_PUBLIC_URL=http://kratos:4433
# KRATOS_ADMIN_URL=http://kratos:4434

# --- Firmware toolchain (defaults shown) ------------------------------------------
# ADMIN_ARDUINO_CLI=arduino-cli
# ADMIN_SKETCH_DIR=firmware/checkpoint
# ADMIN_BUILD_DIR=firmware/checkpoint/build
# ADMIN_FQBN=esp32:esp32:esp32s3:FlashSize=16M,PartitionScheme=app3M_fat9M_16MB,PSRAM=opi,CDCOnBoot=default,USBMode=hwcdc,FlashMode=qio,UploadSpeed=921600

# --- Device admin CLI -------------------------------------------------------------
# How the privileged CLI runs: go (default, needs repo + Go), binary, or ssh.
# ADMIN_DEVICE_ADMIN_MODE=go
# ADMIN_DEVICE_ADMIN_BINARY=C:/tools/device-admin.exe
# ADMIN_DEVICE_ADMIN_SSH_HOST=user@vps
# ADMIN_DEVICE_ADMIN_SSH_DIR=/srv/checkpoint/ingestion-service

# --- Serial -----------------------------------------------------------------------
# ADMIN_DEFAULT_SERIAL_PORT=COM6

# --- Docker (infra view) ----------------------------------------------------------
# Optional Docker context, e.g. ssh://user@vps
# ADMIN_DOCKER_HOST=

# --- Remote (VPS) with SSH tunnels -------------------------------------------------
# Publish Postgres and Kratos admin on the VPS loopback only, then from here:
#   ssh -N -L 15432:127.0.0.1:5432 -L 14434:127.0.0.1:4434 user@vps
# ADMIN_DATABASE_URL=postgres://checkpoint_worker:<password>@localhost:15432/<postgres_db>?sslmode=disable
# ADMIN_KRATOS_ADMIN_URL=http://127.0.0.1:14434

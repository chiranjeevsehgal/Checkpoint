# Admin console agent overrides. Values here win over the repo-root .env.
# Copy to admin-console/.env (gitignored) and adjust.

# Bind address. Keep 127.0.0.1 so the console is local-machine only.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4300

# Backend endpoints reachable from this machine.
# Local docker compose exposes Postgres on 5432, Kratos admin on 127.0.0.1:4434.
ADMIN_KRATOS_ADMIN_URL=http://127.0.0.1:4434
ADMIN_KRATOS_PUBLIC_URL=http://127.0.0.1:4433
ADMIN_INGESTION_URL=http://127.0.0.1:8080

# Set for a remote VPS via SSH tunnels, e.g.:
#   ssh -N -L 15432:127.0.0.1:5432 -L 14434:127.0.0.1:4434 user@vps
# ADMIN_DATABASE_URL=postgres://checkpoint_worker:...@localhost:15432/checkpoint_db?sslmode=disable
# ADMIN_KRATOS_ADMIN_URL=http://127.0.0.1:14434

# Firmware toolchain (defaults shown).
# ADMIN_ARDUINO_CLI=arduino-cli
# ADMIN_SKETCH_DIR=firmware/checkpoint
# ADMIN_BUILD_DIR=firmware/checkpoint/build

# Docker context for the infra view, e.g. ssh://user@vps (optional).
# ADMIN_DOCKER_HOST=

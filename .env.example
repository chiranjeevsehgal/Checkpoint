POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_db>

# RLS roles and the separate Kratos database, created on first Postgres init.
CHECKPOINT_REQUEST_PASSWORD=<checkpoint_request_password>
CHECKPOINT_WORKER_PASSWORD=<checkpoint_worker_password>
# Read-only role used by mcp-service; created on first init or by mcp-migrate.
CHECKPOINT_MCP_PASSWORD=<checkpoint_mcp_password>
KRATOS_DB_PASSWORD=<kratos_db_password>

KAFKA_NODE_ID=1
KAFKA_TOPIC_TRANSCRIPTION=transcription.jobs.v1

MINIO_ROOT_USER=<minio_root_user>
MINIO_ROOT_PASSWORD=<minio_root_password>

# Client-facing MinIO host baked into presigned PUT URLs.
# Default localhost:9000 works for desktop clients only.
# For phone testing on the same Wi-Fi, set this to your PC's LAN IP, e.g.:
# MINIO_PUBLIC_ENDPOINT=192.168.1.4:9000

DEEPGRAM_API_KEY=<deepgram_api_key>

TRANSCRIPTION_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=<elevenlabs_api_key>

GROQ_API_KEY=<groq_api_key>

# Wall-clock zone reminder relative times resolve in; overrides
# reminders.timezone in extraction-service/config.yaml.
REMINDERS_TIMEZONE=Asia/Kolkata

# Fallback IANA zone for rollup-service summaries; a user's stored
# user_settings.timezone wins. Overrides summaries.timezone.
SUMMARIES_TIMEZONE=Asia/Kolkata

# Self-hosted ntfy for reminder push notifications. NTFY_PUBLIC_URL is returned
# to the app and must be reachable from the phone (LAN IP in development).
# NTFY_TOKEN/NTFY_ADMIN_TOKEN are the single source of truth: docker-compose
# provisions them into ntfy via NTFY_AUTH_TOKENS, and the app services read them
# directly. Rotate both together for production.
NTFY_BASE_URL=http://localhost:8085
NTFY_PUBLIC_URL=http://localhost:8085
NTFY_TOKEN=tk_checkpointdevpublishtoken0001
# Admin token provisions each user's read-only topic access (per-user auth).
NTFY_ADMIN_URL=http://ntfy:80
NTFY_ADMIN_TOKEN=tk_checkpointdevadmintoken000001
# Basic-auth password hashes for the two provisioned ntfy users (bcrypt, as
# printed by `ntfy user hash <password>`). Leave unset for local dev; set both
# in production and rotate the live user.db afterwards.
#NTFY_ADMIN_PASS_HASH=$2a$10$...
#NTFY_PUBLISHER_PASS_HASH=$2a$10$...

# Ingestion auth. KRATOS_PUBLIC_URL is the public Kratos API used for session
# validation. DATABASE_REQUEST_URL/DATABASE_WORKER_URL select the RLS request
# role and the trusted background role; development falls back to DATABASE_URL.
KRATOS_PUBLIC_URL=http://kratos:4433
KRATOS_ADMIN_URL=http://kratos:4434
# URL Kratos advertises in flow ui.action; must be reachable by clients.
# Use the LAN IP for phones in development; the public HTTPS URL in production.
KRATOS_PUBLIC_BASE_URL=http://localhost:4433/
# Production mail via Gmail SMTP. Needs an App Password: Google Account →
# Security → 2-Step Verification → App passwords (name it e.g. "Checkpoint
# prod"), then strip the spaces. The 16-letter password needs no URL-encoding.
# Leave commented for local dev (Mailpit). Replies land in this inbox — add a
# Gmail filter on subject "Checkpoint" to keep them out of your main inbox.
#KRATOS_SMTP_URI=smtp://<your-gmail>@gmail.com:<APP_PASSWORD>@smtp.gmail.com:587/
#KRATOS_SMTP_FROM_ADDRESS=<your-gmail>@gmail.com
DATABASE_REQUEST_URL=postgres://checkpoint_request:<checkpoint_request_password>@postgres:5432/<postgres_db>?sslmode=disable
DATABASE_WORKER_URL=postgres://checkpoint_worker:<checkpoint_worker_password>@postgres:5432/<postgres_db>?sslmode=disable
DATABASE_MCP_URL=postgres://checkpoint_mcp:<checkpoint_mcp_password>@postgres:5432/<postgres_db>?sslmode=disable

# MCP retrieval service. MCP_PUBLIC_URL is the public HTTPS origin of the MCP
# endpoint (the OAuth issuer/resource base). In production it must match the
# Caddy host; local development keeps localhost and OAuth stays disabled.
MCP_PUBLIC_URL=http://localhost:1417
MCP_TURBOVEC_BITS=4
MCP_POLL_SECONDS=30
MCP_MAX_TEXT_CHARS=8000

# MCP OAuth authorization server. Enable by setting a session secret and the
# internal Kratos URL; leave blank in local development to use static keys only.
# Generate the secret once: openssl rand -hex 32
MCP_OAUTH_SESSION_SECRET=
MCP_OAUTH_ACCESS_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TTL_SECONDS=2592000
MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,chatgpt.com

# Caddy terminates TLS for MCP_PUBLIC_URL on ports 80/443.
BIND_CADDY_HTTP=0.0.0.0
BIND_CADDY_HTTPS=0.0.0.0

# Unverified identities (abandoned or mistyped signups) are deleted after
# IDENTITY_TTL_HOURS; the cleanup worker sweeps every interval.
IDENTITY_TTL_HOURS=1
IDENTITY_CLEANUP_INTERVAL_MINUTES=15

# Observability (opt-in). Start with: docker compose --profile observability up -d
# All services read LOG_LEVEL (debug|info|warn|error) and emit JSON to stdout.
LOG_LEVEL=info
# Grafana admin password (username is always admin). The alert contact point
# reuses NTFY_TOKEN to publish to the cp-alerts topic.
GRAFANA_ADMIN_PASSWORD=<grafana_admin_password>
BIND_GRAFANA=127.0.0.1
BIND_LOKI=127.0.0.1
BIND_PROMETHEUS=127.0.0.1

# Production also requires DATABASE_URL, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, KAFKA_BROKERS.
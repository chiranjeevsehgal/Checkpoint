POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_db>

KAFKA_NODE_ID=1

MINIO_ROOT_USER=<minio_root_user>
MINIO_ROOT_PASSWORD=<minio_root_password>

# Ingestion service: internal VAD endpoint.
# Local dev default (mock-vad under the dev profile); point at the real
# VAD service URL when it exists.
# In ENV=production VAD_BASE_URL must be explicit http(s) and must not be
# localhost or mock-vad, otherwise config Load fails fast.
VAD_BASE_URL=http://mock-vad:8081
# Production also requires DATABASE_URL, MINIO_ACCESS_KEY, MINIO_SECRET_KEY.
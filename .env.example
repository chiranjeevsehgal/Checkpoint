POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_db>

KAFKA_NODE_ID=1

MINIO_ROOT_USER=<minio_root_user>
MINIO_ROOT_PASSWORD=<minio_root_password>

# Ingestion service: transcription queue (Kafka).
# Workers in transcription-service consume this topic for Deepgram.
KAFKA_TOPIC_TRANSCRIPTION=transcription.jobs.v1
# Production also requires DATABASE_URL, MINIO_ACCESS_KEY, MINIO_SECRET_KEY,
# KAFKA_BROKERS, KAFKA_TOPIC_TRANSCRIPTION.
{{- $context := "" -}}
{{- with .TransientPayload }}{{ $context = printf "%v" (index . "context") }}{{ end -}}
{{- if eq $context "account_deletion" -}}
<p>You asked to delete your Checkpoint account.</p>
<p>Enter this code to confirm the deletion:</p>
<p style="font-size:24px;font-weight:700;letter-spacing:4px">{{ .VerificationCode }}</p>
<p>This code expires in {{ .ExpiresInMinutes }} minutes. If you didn't request this, ignore this email and your account stays as it is.</p>
{{- else -}}
<p>Welcome to Checkpoint.</p>
<p>Enter this code to verify your email address:</p>
<p style="font-size:24px;font-weight:700;letter-spacing:4px">{{ .VerificationCode }}</p>
<p>This code expires in {{ .ExpiresInMinutes }} minutes. If you didn't create a Checkpoint account, you can ignore this email.</p>
{{- end -}}

{
  "expo": {
    "name": "Checkpoint",
    "slug": "checkpoint-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checkpointapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.checkpoint.pendant",
      "infoPlist": {
        "UIBackgroundModes": ["bluetooth-central"],
        "NSBluetoothAlwaysUsageDescription": "Checkpoint syncs recordings from your pendant over Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Checkpoint syncs recordings from your pendant over Bluetooth."
      }
    },
    "android": {
      "package": "com.checkpoint.pendant",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f6f3",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#151514",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "Allow Checkpoint to scan the pendant enrollment QR code."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"]
        }
      ],
      "./plugins/withSyncForegroundService",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "onnxruntime-react-native",
      "react-native-audio-api"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bd770d7-c0a6-4a3c-badd-48ec44fb3db2"
      }
    },
    "owner": "boredom1234"
  }
}

@@ -224,6 +224,17 @@ android {
   externalNativeBuild {
     cmake {
       path "CMakeLists.txt"
+      // Windows MAX_PATH workaround: the default .cxx staging directory lives
+      // too deep under node_modules, and audio-api's out-of-tree common/ sources
+      // make CMake flatten their absolute paths into the object dir, pushing
+      // generated paths past the 260-char Windows limit. Stage the native build
+      // in a short root instead. Override with RN_AUDIO_API_CXX_DIR if C:/rnc
+      // is not writable on this machine.
+      def rnAudioCxxDir = System.getenv("RN_AUDIO_API_CXX_DIR")
+      if (rnAudioCxxDir == null || rnAudioCxxDir.trim().isEmpty()) {
+        rnAudioCxxDir = rootProject.rootDir.absolutePath.substring(0, 2) + "/rnc"
+      }
+      buildStagingDirectory = new File(rnAudioCxxDir)
     }
   }
 

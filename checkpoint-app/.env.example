# Copy to .env.local and fill in. Never commit secrets.
# Anything prefixed EXPO_PUBLIC_ is visible to the client — never put secrets there.

# On-device testing needs the dev machine LAN IP — a phone cannot reach localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_ENV=development
